# =========================================================================
# Neon Database Connection String (Serverless PostgreSQL)
# =========================================================================
#
# ขั้นตอนการใช้งาน:
# 1. คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env
# 2. ไปที่หน้า Console ของ Neon (https://neon.tech/) เข้าสู่โปรเจกต์ของคุณ
# 3. คัดลอก Connection String (เริ่มด้วย postgresql://...)
# 4. นำมาแทนที่ค่าด้านล่างนี้
#
DATABASE_URL=postgresql://[user]:[password]@[neon_hostname]/[database_name]?sslmode=require
